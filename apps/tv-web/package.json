{
  "name": "wicaby-tv-web",
  "productName": "Wicaby",
  "description": "Wicaby for TVs that run web apps (Samsung Tizen, LG webOS)",
  "author": "Wika",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/check-strings.mjs",
    "package:tizen": "npm run build && node scripts/package-wgt.mjs",
    "package:webos": "npm run build && node scripts/package-ipk.mjs",
    "engines": "node scripts/fetch-engines.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "acorn": "8.19.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
